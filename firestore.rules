// ⚠️ SOLO REFERENCIA — NO DEPLOYAR ESTE ARCHIVO.
// El proyecto de Firebase (hike-agentic-playground) es compartido con otras apps
// (ABN Suite, entre otras) y sus reglas publicadas incluyen las colecciones de
// todas. Deployar este archivo borraría las reglas de las otras apps. Por eso
// firebase.json ya no lo referencia.
//
// Esta es la parte de las reglas publicadas que usa este portal (verificada el
// 2026-09-27). Para cambiarla, editala dentro de las reglas completas en la
// consola de Firebase → Firestore → Reglas.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Asistencia — cualquier usuario autenticado (anónimo ok) puede leer y escribir
    match /attendance/{docId} {
      allow read, write: if request.auth != null;
    }

    // Entregas de proyectos
    match /submissions/{docId} {
      allow read, write: if request.auth != null;
    }

    // Notas por alumno (solo escritas desde el panel admin)
    match /studentNotes/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
